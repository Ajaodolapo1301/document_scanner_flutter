<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.document.scanner.flutter.document_scanner_flutter">
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Note: READ_MEDIA_IMAGES removed - using system photo picker for Android 13+ instead -->

    <application
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true">
        <activity
            android:name="com.scanlibrary.ScanActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/ScanActivityTheme"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" >
        </activity>
        <!-- Note: FileProvider is provided by AndroidDocumentScanLibrary with authority "com.scanlibrary.provider" -->
    </application>
</manifest>
